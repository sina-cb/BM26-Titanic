      "pattern": "61_white_breathe",
      "title": "White Breathe",
      "goal": "One slow white inhale moves through the ship as five coordinated but non-identical breaths.",
      "intent": {
        "schema_version": 1,
        "concept": "One slow white inhale moves through the ship as five coordinated but non-identical breaths.",
        "design_intent": "Preserve the recognizable whole-rig breath while separating Hull volume, Silhouette crest, Jewelry pearls, Organ answers, and readable Identity.",
        "why_exists": "It is the family's soft organism: a welcoming white motion that reads as one body without a synchronized flat pulse.",
        "visual_goal_titanic": "The silhouette should stay visible through every exhale; Jewelry should reveal a sequential necklace inhale; Organs should answer the breath rather than merely copy its brightness.",
        "unique_topology": "Two incommensurate scalar breaths combine with a signed oblique XYZ roll; role branches resample that envelope into physical breathing vocabularies.",
        "distance_silhouette": "A travelling crest rides a continuous contour floor so the full vessel remains recognizable at the lowest point of the inhale.",
        "close_detail": "Six-head pearl breathing, staggered par sources, Hull vertical volume, and gentle complete folded 74-pixel sign breath reward close viewing.",
        "motion_grammar": "One signed clock reverses the whole breath and its quicker spatial roll; all phases use large seam-free wraps and controls slew smoothly.",
        "xyz_use": "Centered X/Y/Z create the oblique rolling volume; pixelLocalIndex sequences Jewelry, and fixtureId offsets Organ breaths. Identity computes signIndex = index % 74 and remaps that folded address into one complete 10x8/74-pixel local surface; both physical 40+34 signs therefore use identical local coordinates.",
        "fixture_roles": {
          "Hull Canvas": "Broad luminous volume with a slow vertical lift.",
          "Silhouette": "Continuous contour carrying the clearest travelling breath crest.",
          "Jewelry": "Hero six-pearl necklace inhaling head by head with native-white cores.",
          "Organs": "Staggered single-source answers to the shared inhale.",
          "Identity": "Both physical signs render the same complete, non-repeating 74-pixel breathing nameplate from signIndex=index%74; the full surface inhales while retaining a protected floor."
        },
        "te_sign_treatment": "Both physical signs render the same complete, non-repeating 74-pixel breathing nameplate from signIndex=index%74; the full surface inhales while retaining a protected floor.",
        "jewelry_white": "Native white concentrates in the sequential pearl crests; the rail bed stays warm-neutral RGB so the six heads retain visible shape between crests.",
        "palette_white_material": "No colorPalette exports; warm-neutral RGB, W=A byte-identical, and U=0 make every breath white and globally untintable.",
