{
  "name": "marsin-engine",
  "version": "1.0.0",
  "description": "Multichannel Pixelblaze rendering engine with sACN output",
  "type": "module",
  "main": "engine.js",
  "scripts": {
    "start": "node engine.js",
    "rainbow": "node engine.js --pattern rainbow --model test_bench",
    "breathing": "node engine.js --pattern test/breathing --model test_bench",
    "fire": "node engine.js --pattern test/fire --model test_bench",
    "bio": "node engine.js --pattern 11_bioluminescence --model test_bench",
    "golden": "node engine.js --pattern 00_golden_hour_wash --model test_bench",
    "test": "node --import ./tests/setup_config_guard.mjs --test tests/*.test.js",
    "check:syntax": "node --check engine.js",
    "check:dry-run": "node engine.js --pattern test_const --model test_bench --dry-run",
    "check": "npm run check:syntax && npm run check:dry-run",
    "test:hil:transition": "node tests/hil/hil_transition_test.mjs",
    "perf:baseline": "node tools/perf_gauge.mjs --write-baseline",
    "perf:gate": "node tools/perf_gauge.mjs --gate",
    "check:rainbow": "node engine.js --pattern rainbow --model test_bench --dry-run",
    "check:breathing": "node engine.js --pattern test/breathing --model test_bench --dry-run",
    "check:fire": "node engine.js --pattern test/fire --model test_bench --dry-run",
    "check:syntax": "node --check engine.js",
    "check:dry-run": "node engine.js --pattern test_const --model test_bench --dry-run",
    "check": "npm run check:syntax && npm run check:dry-run",
    "test:hil:autopilot-profile": "node tests/hil/hil_autopilot_profile_test.mjs",
    "test:hil:audio-reactive": "node tests/hil/hil_audio_reactive_profile_test.mjs",
    "test:hil:deck-slots": "node tests/hil/hil_deck_playlist_slots_test.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "fft.js": "^4.0.4",
    "js-yaml": "^4.1.1",
    "osc-min": "^2.1.2",
    "sacn": "^4.5.0",
    "ws": "^8.20.0"
  }
}
