# =============================================================
#  LookingGlass — SECRETS template
#  Copy this file to `secrets.yaml` (same directory) and fill in real
#  values. `secrets.yaml` is gitignored and MUST NEVER be committed —
#  this is a PUBLIC repository.
#
#  Read at BUILD time by panel_firmware/scripts/gen_config.py and at flash
#  time by panel_firmware/deploy.py.
#
#  SHARED ACROSS WORKTREES: copy this template to
#  ~/workspace/BM26-Titanic-Secrets/panel_secrets.yaml, fill in real values, and
#  set the env var PANEL_SECRETS to that path to use one gitignored secret for
#  every worktree/branch; both tools honor it (and fall back to this local file).
# =============================================================

# Deploy target — the ESP32-S3 factory base / STA MAC of the board this
# firmware deploys to. The MAC-locked flasher (panel_firmware/deploy.py)
# verifies a connected board's MAC against this value before flashing, so
# you never flash the wrong board. Read it from the connected board with
# `python -m esptool read-mac`, or run `python deploy.py --pair` to have
# deploy.py detect the single connected board and write its MAC here.
device:
  mac: "AA:BB:CC:DD:EE:FF"

# WiFi station — the existing network the panel joins (used when
# wifi.enabled is true in config.yaml).
wifi:
  ssid: "YOUR_WIFI_SSID"
  password: "YOUR_WIFI_PASSWORD"

# Access Point password for the panel's own captive-portal network.
# Leave empty ("") for an OPEN AP, or set 8+ chars for WPA2.
ap:
  password: ""

# Add any other secrets (API tokens, bridge keys, …) below as the
# project grows.
