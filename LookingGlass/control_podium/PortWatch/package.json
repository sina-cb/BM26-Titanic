{
  "name": "portwatch",
  "private": true,
  "version": "0.2.0",
  "description": "PortWatch — TITANIC field-ops iPhone/iPad app. BLE→LoRa control surface and live status display for the rig.",
  "main": "index.js",
  "scripts": {
    "postinstall": "node ./scripts/sync-secret.mjs --allow-missing && node ./scripts/sync-config.mjs",
    "sync-secret": "node ./scripts/sync-secret.mjs",
    "sync-config": "node ./scripts/sync-config.mjs",
    "sync-all": "npm run sync-secret && npm run sync-config",
    "prestart": "npm run sync-all",
    "preios": "npm run sync-all",
    "preprebuild": "npm run sync-all",
    "preeas:build:dev": "npm run sync-all",
    "preeas:build:preview": "npm run sync-all",
    "preeas:build:store": "npm run sync-all",
    "start": "expo start --dev-client",
    "ios": "expo run:ios --device",
    "ios:simulator": "expo run:ios",
    "prebuild": "expo prebuild --platform ios --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "npx expo-doctor",
    "eas:device": "eas device:create",
    "eas:login": "eas login",
    "eas:whoami": "eas whoami",
    "eas:build:dev": "eas build --platform ios --profile development",
    "eas:build:preview": "eas build --platform ios --profile preview",
    "eas:build:store": "eas build --platform ios --profile production",
    "eas:submit": "eas submit --platform ios --latest",
    "ble:scan": "../../.venv-dev/bin/python3 ./scripts/ble-scan.py",
    "serial:monitor": "../../.venv-dev/bin/python3 -c \"import serial,sys,glob; ports=[p for p in glob.glob('/dev/cu.usbmodem*')]; assert ports, 'no Heltec serial port found'; print('monitoring', ports[0]); s=serial.Serial(ports[0],115200,timeout=1); [sys.stdout.write(s.read(2048).decode('utf-8','replace')) or sys.stdout.flush() for _ in iter(int,1)]\"",
    "android": "expo run:android"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.34",
    "expo-haptics": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "js-yaml": "^4.1.0",
    "typescript": "~5.9.2",
    "vitest": "^2.1.9"
  }
}
