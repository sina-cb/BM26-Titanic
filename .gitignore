# IDE / Editor
.vscode/

# Agent renders (generated output)
.agent_renders/
.puppeteer-endpoint

# Pre-save scene snapshots written by simulation/server/scene_backup.cjs
# (source for the in-sim "Recover scene" UI). Local safety net, never committed.
simulation/.scene_backups/

# Dependencies
node_modules/
# Also ignore a node_modules SYMLINK (worktree shares deps via a symlink, which
# the trailing-slash rule above does NOT match — a tracked symlink merged into
# another checkout becomes a self-referential link and breaks module resolution).
node_modules

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# ZeroG runtime (machine-specific)
.agent/workspace.yaml
.agent/pids/
.vscode-antigravity/

# Show-server manifest (real hostnames/IPs/shares). PRIVATE - lives in the
# BM26-Firmware-Deployment repo, exported as $BM26_MACHINES; deploy.py ships it
# to each server at deploy time. This public repo must never contain it. Use
# deploy/machines.yaml.example (tracked, placeholder values) as the shape ref.
deploy/machines.yaml

# Control podium runtime state (MACs paired to roles)
control_podium/.config.pairing.yaml
control_podium/.config.deploy.yaml
# Node table hardware pairing overlay (node id → usb_mac). Real device
# MACs stay out of the committed .config.nodes.yaml — this repo is
# public. Written by firmware/deploy.py; merged by utils/nodes_config.py.
control_podium/.config.nodes.pairing.yaml

# server_bridge — Pi SSH credentials. Each developer maintains their
# own copy from `.ssh.secret.example`; never committed.
control_podium/server_bridge/.ssh.secret

# Per-developer / per-show network topology overlay (host + port for
# engine / bridge / simulation). Not used by anything on this branch
# but tolerated on disk so PortWatch / CaptainPad checkouts that DO
# read it stay happy.
/network.yaml

# CaptainPad generated topology constants (regenerated by
# CaptainPad/scripts/sync-config.mjs from network.yaml).
CaptainPad/constants/network.generated.ts

# PortWatch (iPhone/iPad field-ops app, Expo): build-time-baked copy of
# marsin_engine/secret.yaml. Generated by
# control_podium/PortWatch/scripts/sync-secret.mjs from the canonical
# YAML in marsin_engine/. Each developer regenerates this locally,
# never committed.
control_podium/PortWatch/src/_generated/

# Expo native build outputs for PortWatch (regenerated by
# `expo prebuild`). The TypeScript / RN sources are committed.
control_podium/PortWatch/ios/
control_podium/PortWatch/android/
control_podium/PortWatch/.expo/
control_podium/PortWatch/dist/

# Same convention for CaptainPad: generated by `expo prebuild`,
# regenerable from app.json + plugins. Local-only Release builds
# land here too (build/, Pods/, xcworkspace). Never committed.
CaptainPad/ios/
CaptainPad/android/
CaptainPad/.expo/
CaptainPad/dist/

# v2 secured-channel pre-shared key. Lives next to the engine because the
# engine is the canonical source of truth for the camp's shared secret;
# every TITANIC component (companions, future CaptainPad, future fire
# station bridge) reads the SAME file. `secret.yaml.example` is committed
# as documentation; `secret.yaml` is hand-deployed per camp and MUST
# never land in git. See docs/07_control_podium.md §3.6.
marsin_engine/secret.yaml
!marsin_engine/secret.yaml.example

# MIC TUNE calibration profiles — per-machine operator state written by the Audio
# Companion at runtime. Defaults are seeded from mic_profiles.js, so a fresh
# checkout always has profiles; the operator's custom/calibrated profiles stay
# local (like audio_config.yaml). Never committed.
marsin_engine/audio/companion/mic_profiles.yaml

__pycache__/
*.pyc
.pytest_cache/
control_podium/logs/


# Python caches
*.py[cod]
*.class
*.so
.mypy_cache/
.tox/
coverage.xml
htmlcov/
dist/
build/
*.egg-info/
venv/
.venv/
env/
.env

# PlatformIO / embedded caches
.pio/
.pioenvs/
.piolibdeps/
.vscode-test/

# LookingGlass control panel — build-time generated config (gitignored).
# Secrets (WiFi/AP creds) come from a private, external deployment source via
# $BM26_SECRETS / $STOKER_SECRETS — NOT in this public repo. The generated/
# header is baked from config.yaml + those env-provided secrets at build time.
LookingGlass/panel_firmware/include/generated/

# Node caches & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.nyc_output/
coverage/

# IDE / Editor caches
.idea/
*.swp
*.swo
*~

# Global Logs
*.log
tmp/

# save-server atomic-write temp files (crash residue, auto-cleaned)
*.tmp-*

marsin_pb/wasm/*-Live-*.js
marsin_pb/wasm/*-Live-*.wasm

# Per-developer config overrides (not committed). These deep-merge
# on top of the committed defaults at flash/build time — see
# firmware/deploy.py::load_firmware_config and PortWatch's
# scripts/sync-config.mjs for the pattern.
control_podium/.config.firmware.local.yaml
control_podium/PortWatch/.config.portwatch.local.yaml

# Local binaries
bin/
marsin_engine/bin/

# HIL test artifacts — the hil_*_test.mjs tests create disposable
# playlists via the engine API and delete them on cleanup. If a test
# crashes before cleanup runs, the YAML lingers; ignoring the pattern
# keeps those crash artifacts out of git regardless.
simulation/scenes/*/playlists/hil_*.yaml


# Vendored offline browser assets — the generic build/ rule above would
# otherwise swallow the pinned three.js builds needed for playa offline mode.
!simulation/vendor/three/build/
!simulation/vendor/three/build/**

# Claude Code local settings + agent worktrees (machine-local / transient).
# `.claude/*` (not `.claude/`) so the negation below can re-include the
# COMMITTED project settings — the pre-commit security-gate hook lives
# there and must ship with the repo. Everything else under .claude/
# (settings.local.json, worktrees/, projects/) stays ignored.
.claude/*
!.claude/settings.json

# Local-only short-term tracking reports (operator scheduling / dated
# planning). Deliberately NEVER committed — schedule dates stay out of
# the public repo (Sina 2026-07-28). Durable outcomes still go to the
# tracked .agent/reports/ + master doc, without dates-as-commitments.
.agent/reports_local/

# Timeline companion runtime state (regenerated on boot)
marsin_engine/states/*/timeline_state.yaml
# Autopilot RUNTIME state (active/delay/shuffle). Split out of the tracked,
# comment-bearing config.yaml, which normal show operation was rewriting on
# every arm/disarm/deadman/crash-boot. See lib/autopilot.js RUNTIME_FILE.
marsin_engine/config.autopilot_runtime.yaml
marsin_engine/*.autopilot_runtime.yaml
# Same split for the COLOUR autopilot, which was still rewriting config.yaml on
# every disarm — measured turning triggerMask: 0x07 into 7 as collateral.
# See lib/color_autopilot.js runtimeFile.
marsin_engine/config.color_autopilot_runtime.yaml
marsin_engine/*.color_autopilot_runtime.yaml

# Local-only dev scene for the physical LED-controller bench (contains real
# device MACs/provenance — never commit; Sina 2026-07-10).
simulation/scenes/dev_test_bench/
marsin_engine/models/dev_test_bench*

# Third-party setup tools live here locally, downloaded on first setup by
# deploy\setup\get_autologon.ps1 - the Sysinternals license forbids
# republishing them, and this repo is public.
deploy/setup/tools/
